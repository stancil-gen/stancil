package apis

import (
{{ range .Imports }}
	"{{ . }}"
{{ end }}
)

{{ range .Steps }}
// {{ .StepName }}Input strongly defines the input map constraints dynamically routed for Execution Mappers
type {{ .StepName }}Input struct {
{{ if and (eq .Kind "Table") (eq .Op "create") }}
	Data *tables.{{ .ModelRef }}
{{ else if and (eq .Kind "Table") (eq .Op "get") }}
	ID string
{{ else if and (eq .Kind "Table") (eq .Op "update") }}
	ID   string
	Data *tables.{{ .ModelRef }}
{{ else if and (eq .Kind "Table") (eq .Op "delete") }}
	ID string
{{ else if and (eq .Kind "Table") (eq .Op "list") }}
	Limit  int
	Offset int
{{ end }}
}

// {{ .StepName }}Output cleanly extracts standard query limits bounding topological side-effects!
type {{ .StepName }}Output struct {
{{ if eq .Kind "Table" }}
{{ if or (eq .Op "create") (eq .Op "get") (eq .Op "update") }}
	Result *tables.{{ .ModelRef }}
{{ else if eq .Op "list" }}
	Results []*tables.{{ .ModelRef }}
{{ end }}
{{ end }}
}
{{ end }}
